# ======================================================================
#  Control de caché: fuerza la recarga de HTML/CSS/JS en cada deploy.
#  Solo aplica en servidores Apache (en otros hosts este archivo se ignora).
# ======================================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
